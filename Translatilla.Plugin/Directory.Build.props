<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <PropertyGroup>
        <GamePath Condition="'$(GamePath)'==''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GamePath>

        <DependenciesPath Condition="'$(DependenciesPath)'==''">$(MSBuildThisFileDirectory)..\Build\Dependencies</DependenciesPath>
        <CI Condition="'$(CI)'=='' and Exists('$(MSBuildThisFileDirectory)..\Libs')">TRUE</CI>
    </PropertyGroup>

    <PropertyGroup Condition="'$(CI)'=='TRUE'">
        <GameAssemblyPath Condition="'$(GameAssemblyPath)'==''">$(MSBuildThisFileDirectory)..\Libs</GameAssemblyPath>
        <GamePath>$(MSBuildThisFileDirectory)..\Build\output</GamePath>
    </PropertyGroup>

    <PropertyGroup>
        <GameAssemblyPath Condition="'$(GameAssemblyPath)'==''">$(GamePath)\Gorilla Tag_Data\Managed</GameAssemblyPath>
    </PropertyGroup>
</Project>
